{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && tsx --test src/**/*.test.ts",
    "cms:inventory": "tsx ./src/cms/inventory.ts",
    "cms:import": "tsx ./src/cms/import.ts",
    "cms:reconcile": "tsx ./src/cms/reconcile.ts",
    "cms:verify": "tsx ./src/cms/verify.ts",
    "cms:import-task-295-media": "tsx ./src/cms/task-295-media-import.ts",
    "cms:import-banking-media": "tsx ./src/cms/banking-media-import.ts",
    "cms:reconcile-banking-successor": "tsx ./src/cms/banking-successor.ts",
    "cms:setup-banking-successor": "tsx ./src/cms/banking-successor.ts",
    "cms:setup-banking-postmerge": "pnpm cms:import-banking-media -- --apply-db --target=development --write && pnpm cms:reconcile-banking-successor -- --apply-db --target=development --write",
    "cms:verify-banking-publication": "tsx ./src/cms/banking-publication-verify.ts",
    "cms:publish-industry-images": "tsx ./src/cms/industry-cutover.ts",
    "cms:publish-education-imagery": "tsx ./src/cms/industry-cutover.ts --slug=education",
    "cms:reconcile-site-heroes": "tsx ./src/cms/hero-reconciliation.ts",
    "cms:reconcile-methodologies-hero": "tsx ./src/cms/methodologies-reconciliation.ts",
    "cms:reconcile-value-to-scale-hero": "tsx ./src/cms/value-to-scale-hero-reconciliation.ts",
    "cms:reconcile-offices": "tsx ./src/cms/office-reconciliation.ts",
    "cms:backup": "tsx ./src/cms/backup.ts",
    "cms:verify-backup": "tsx ./src/cms/verify-backup.ts",
    "cms:rehearse-rollback": "tsx ./src/cms/rehearse-rollback.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@workspace/db": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "~5.9.3",
    "tsx": "catalog:"
  }
}
