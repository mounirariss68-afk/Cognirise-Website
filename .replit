modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"
packages = ["libreoffice", "blender", "xorg.xorgserver", "mesa", "ffmpeg"]

[userenv]

[userenv.development]
VITE_CMS_CUTOVER_INDUSTRIES = "true"

[userenv.shared]
EDITORIAL_DIGEST_FROM = "Cognirise Editorial <support@cognirise.ai>"
EDITORIAL_DIGEST_SAFE_RECIPIENT = "mounir@cognirise.ai"
