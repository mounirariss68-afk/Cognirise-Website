modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[userenv]

[userenv.development]
VITE_CMS_CUTOVER_INDUSTRIES = "true"

[userenv.shared]
EDITORIAL_DIGEST_FROM = "Cognirise Editorial <support@cognirise.ai>"
EDITORIAL_DIGEST_SAFE_RECIPIENT = "mounir@cognirise.ai"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18741
externalPort = 80

[[ports]]
localPort = 22090
externalPort = 3001

[[ports]]
localPort = 26081
externalPort = 3000
