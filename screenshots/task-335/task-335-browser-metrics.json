      {
        "index": 44,
        "tag": "EM",
        "text": "One common setting, or individually governed handovers—the Agent Authority Model governs each handover.",
        "fontSize": 16,
        "afterFontSize": 32,
        "ratio": 2
      },
      {
        "index": 45,
        "tag": "SPAN",
        "text": "+Read the full explanation",
        "fontSize": 14,
