      {
        "index": 50,
        "tag": "EM",
        "text": "\"we have four-eyes checks, therefore we have a delegation of authority.\"",
        "fontSize": 16,
        "afterFontSize": 32,
        "ratio": 2
      },
      {
        "index": 51,
        "tag": "H3",
        "text": "Why the unit is the whole argument",
