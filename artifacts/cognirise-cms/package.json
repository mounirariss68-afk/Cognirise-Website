{
  "name": "@workspace/cognirise-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev --host 0.0.0.0 --port ${PORT:-3333}",
    "build": "sanity build",
    "serve": "sanity preview --host 0.0.0.0 --port ${PORT:-3333}",
    "deploy": "sanity deploy",
    "schema:extract": "sanity schema extract --path schema.json --enforce-required-fields",
    "typegen": "pnpm run schema:extract && sanity typegen generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@sanity/vision": "^4.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanity": "^4.0.0",
    "styled-components": "^6.1.0",
    "tsx": "catalog:",
    "typescript": "^5.9.0"
  }
}